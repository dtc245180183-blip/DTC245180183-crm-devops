# Node.js Application Configuration
NODE_ENV=production
PORT=3000
SESSION_SECRET=example_session_secret_at_least_32_chars_long

# PostgreSQL Database Configuration
POSTGRES_DB=crm
POSTGRES_USER=crm_app
POSTGRES_PASSWORD=example_strong_db_password_min_20_chars

DB_HOST=db
DB_PORT=5432
DB_NAME=crm
DB_USER=crm_app
DB_PASSWORD=example_strong_db_password_min_20_chars

# Seed User Passwords (for initial bootstrap)
SEED_MANAGER_PASSWORD=example_strong_manager_seed_pass_24c
SEED_SALES_PASSWORD=example_strong_sales_seed_pass_24c
SEED_SUPPORT_PASSWORD=example_strong_support_seed_pass_24c

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=example_strong_pgadmin_password_min_20_chars

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=example_strong_grafana_password_min_20_chars

# Postgres Exporter Configuration
POSTGRES_EXPORTER_USER=exporter
POSTGRES_EXPORTER_PASSWORD=example_strong_exporter_password_min_20_chars
