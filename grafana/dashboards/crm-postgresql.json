      "title": "Active Backends (S\u1ed1 k\u1ebft n\u1ed1i)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "pg_stat_database_numbackends{datname=\"crm\"}",
          "legendFormat": "Connections (crm)",
          "range": true,
          "refId": "A"
        }
      ]
    },
