    {
      "id": 5,
      "title": "Cache Hit Ratio (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(pg_stat_database_blks_hit{datname=\"crm\"}[1m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"crm\"}[1m])) + sum(rate(pg_stat_database_blks_read{datname=\"crm\"}[1m])) > 0))",
          "legendFormat": "Cache Hit Ratio %",
          "range": true,
          "refId": "A"
        }
      ]
    }
