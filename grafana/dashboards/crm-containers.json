  "panels": [
    {
      "id": 1,
      "title": "Container Memory Usage (RAM)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "container_memory_usage_bytes{id=~\"/.*\"}",
          "legendFormat": "{{name}} ({{id}})",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
